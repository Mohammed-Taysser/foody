
# ─────────────────────────────
# 🌍 APP SETTINGS
# ─────────────────────────────
NODE_ENV=development # development | production | test
PORT=8080
ALLOWED_ORIGINS=
DEFAULT_TIMEZONE=UTC
LOCALE_DEFAULT=en
APP_NAME=Foody

# ─────────────────────────────
# 🗄️ DATABASE CONFIGURATION
# ─────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/foody

# ─────────────────────────────
# 🔑 AUTH / JWT SETTINGS
# ─────────────────────────────
JWT_SECRET=jwt_super_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=10m
JWT_EMAIL_VERIFICATION_EXPIRES_IN=10m

# ─────────────────────────────
# 🔒 SECURITY / RATE LIMITING
# ─────────────────────────────
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_CORS=true

# ─────────────────────────────
# 🧪 TEST VARIABLES
# ─────────────────────────────
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/foody_test

# Default credentials for integration tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=123456789
